# Database configuration
# The URL below works for the default docker-compose setup (mapped to port 5434 on host)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5434/farmland_db

# Logging level
LOG_LEVEL=INFO

# CORS configuration
# Comma-separated list of authorized origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# API Security Key
API_KEY=your_secure_api_key_here

