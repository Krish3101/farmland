# ./scripts/start.sh copies this to .env and fills the empty secrets with random values.
# PostGIS is published on 127.0.0.1:${DB_PORT}.
POSTGRES_USER=farmland
POSTGRES_PASSWORD=
POSTGRES_DB=farmland_db
DB_PORT=5434
# Left empty, start.sh builds it from the values above.
DATABASE_URL=

# Sent by clients in the X-API-Key header. The API refuses to start without it.
API_KEY=
